<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AUV design comparison</title><style>body{font:15px/1.45 system-ui,sans-serif;max-width:1200px;margin:auto;padding:30px;color:#172033}table{border-collapse:collapse;width:100%;font-size:12px}th,td{border:1px solid #bcccdc;padding:6px;text-align:right}th:first-child,td:first-child{text-align:left}img{max-width:100%}code{overflow-wrap:anywhere}</style></head><body><h1>AUV hydrodynamic design comparison</h1><p>Only the newest accepted medium-grid production result per exact design/configuration/build/mesh/speed key is shown. Grid uncertainty is qualified at the reference speed only.</p>{% if chart_data_uri %}<img src="{{ chart_data_uri }}" alt="Cross-design drag comparison">{% endif %}<table><thead><tr>{% for column in columns %}<th>{{ column }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr>{% for column in columns %}<td>{% if column == 'report_path' and row[column] %}<a href="{{ row[column] }}">report</a>{% else %}{{ row[column] }}{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table></body></html>
